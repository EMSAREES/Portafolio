---
import translations from '../data/translations.json';
const tr = translations.es;
---

<section id="contact" class="min-h-screen flex items-center justify-center bg-ink-950 py-20 px-6 md:px-10">
    <div class="max-w-5xl w-full">

        <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-14 items-start">

            <!-- Texto -->
            <div class="space-y-8 order-2 lg:order-1">
                <div>
                    <span class="section-label text-sm font-mono block mb-3">contact</span>
                    <h2 data-i18n="contact.title" class="text-4xl md:text-5xl font-display font-semibold text-paper-50">
                        {tr.contact.title}
                    </h2>
            </div>

            <p data-i18n="contact.subtitle" class="text-paper-300 text-lg max-w-xl">
                {tr.contact.subtitle}
            </p>


            <div class="space-y-5">

                <div class="flex flex-col md:flex-row gap-8">
                    <!-- Email -->
                    <div class="flex items-center gap-4">
                        <div class="p-3 bg-ink-800 rounded-xl shrink-0">
                            <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                            <div class="min-w-0">
                            <h3 data-i18n="contact.email" class="text-sm text-paper-300 mb-1">{tr.contact.email}</h3>
                            <a href={`mailto:${tr.contact.gmail}`} class="text-paper-50 text-lg font-medium hover:text-accent-400 transition-colors break-all">
                                {tr.contact.gmail}
                            </a>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="flex items-center gap-4">
                        <div class="p-3 bg-ink-800 rounded-xl shrink-0">
                            <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </div>
                        <div>
                            <h3 data-i18n="contact.Location" class="text-sm text-paper-300 mb-1">{tr.contact.Location}</h3>
                            <p data-i18n="contact.contry" class="text-paper-50 text-lg font-medium">{tr.contact.contry}</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Social Links -->
                <div class="flex gap-4 pt-6">
                        <a 
                            href={tr.contact.github}
                            data-i18n-attr="href:contact.github"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-3 border border-ink-600 rounded-full hover:border-accent-500 hover:text-accent-400 transition-all duration-300 hover:scale-110 group"
                            aria-label="GitHub"
                        >
                            <svg class="w-5 h-5 text-paper-300 group-hover:text-accent-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                            </svg>
                        </a>
                        
                        <a 
                            href={tr.contact.linkedin}
                            data-i18n-attr="href:contact.linkedin"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="p-3 border border-ink-600 rounded-full hover:border-accent-500 hover:text-accent-400 transition-all duration-300 hover:scale-110 group"
                            aria-label="LinkedIn"
                        >
                            <svg class="w-5 h-5 text-paper-300 group-hover:text-accent-400 transition-colors" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                            </svg>
                        </a>
                    </div>
                </div>


                <!-- Anclaje visual: mismo marco tipo boceto que usan Hero y About, así las tres secciones comparten un mismo lenguaje visual. -->
            <!-- <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
                    <div class="sketch-frame">
                        <div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl border border-ink-600 bg-ink-800 flex items-center justify-center">
                            <svg class="w-20 h-20 text-accent-400/70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                    </div>
                </div> -->
            </div>

        <p class="text-center text-paper-300/50 text-sm font-mono mt-20">
            © {new Date().getFullYear()} Emilio R. — <span data-i18n="footer.built">hecho con café y demasiadas pestañas abiertas</span>
        </p>
        
    </div>
</section>

<script define:vars={{translations}}>

    //Liste for lennguage cjange event
    document.addEventListener('languageChanged', (event) =>{
        const lang = event.detail.lang;
        updateContactContent(lang);
    })
    
    function updateContactContent(lang){
        const titleEl = document.getElementById('contact-title');
        if (titleEl) {
            titleEl.textContent = translations[lang].contact.title;
        }
        
        const subtitleEl = document.getElementById('contact-subtitle');
        if (subtitleEl) {
            subtitleEl.textContent = translations[lang].contact.subtitle;
        }

        const emailEl = document.getElementById('contact-email');
        if(emailEl){
            emailEl.textContent = translations[lang].contact.email;
        }

        const LocationEl = document.getElementById('contact-loca');
        if(LocationEl){
            LocationEl.textContent = translations[lang].contact.Location;
        }

    }

</script>
---
// Card.astro
// Componente reutilizable — como un componente React que recibe props.
// NO sabe qué datos tiene adentro, solo los muestra.
// Puedes usarlo en Proyectos, Certificaciones, Blog, lo que sea.
//
// USO EJEMPLO:
//   <Card
//     image="/img/proyecto.png"
//     title="Mi Proyecto"
//     description="Descripción corta"
//     badges={["React", "Node.js"]}
//     codeUrl="https://github.com/..."
//     demoUrl="https://demo.com"
//     codeLabel="Código"
//     demoLabel="Demo"
//     index={0}
//     dataId="mi-proyecto"
//   />

interface Props {
  image: string;
  title: string;
  description: string;
  badges?: string[];       // Las pastillas de tecnologías (o categorías, o tags)
  codeUrl?: string;        // URL del repositorio (opcional)
  demoUrl?: string;        // URL del demo (opcional)
  codeLabel?: string;      // Texto del botón código
  demoLabel?: string;      // Texto del botón demo
  index?: number;          // Para la animación escalonada
  dataId?: string;         // ID único para actualizar con JS al cambiar idioma
}

const {
  image,
  title,
  description,
  badges = [],
  codeUrl,
  demoUrl,
  codeLabel = 'Code',
  demoLabel = 'Demo',
  index = 0,
  dataId,
} = Astro.props;
---

<article
  class="card group bg-slate-800/50 backdrop-blur-sm rounded-2xl overflow-hidden border border-cyan-500/20 hover:border-cyan-500/60 transition-all duration-500 hover:shadow-2xl hover:shadow-cyan-500/20 hover:-translate-y-2"
  style={`transition-delay: ${(index + 1) * 0.1}s`}
  data-id={dataId}
>
  <!-- Imagen del proyecto -->
  <div class="relative h-64 overflow-hidden bg-slate-900">
    <img
      src={image}
      alt={title}
      class="card-image w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/50 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-300"></div>

    <!-- Badges (tecnologías, tags, etc.) -->
    {badges.length > 0 && (
      <div class="card-badges absolute top-4 left-4 flex flex-wrap gap-2">
        {badges.slice(0, 3).map((badge) => (
          <span class="px-3 py-1 bg-cyan-500/90 backdrop-blur-sm text-white text-xs font-semibold rounded-full">
            {badge}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Contenido -->
  <div class="p-6 space-y-4">
    <h3 class="card-title text-2xl font-bold text-white group-hover:text-cyan-400 transition-colors duration-300">
      {title}
    </h3>

    <p class="card-description text-gray-400 text-sm line-clamp-3">
      {description}
    </p>

    <!-- Botones -->
    <div class="flex gap-4 pt-4">
      {codeUrl && (
        <a
          href={codeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-slate-700 hover:bg-cyan-500 text-white font-semibold rounded-lg transition-all duration-300 group/btn"
        >
          <!-- Ícono GitHub -->
          <svg class="w-5 h-5 transition-transform duration-300 group-hover/btn:rotate-12" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span class="card-code-label">{codeLabel}</span>
        </a>
      )}

      {demoUrl && (
        <a
          href={demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-lg transition-all duration-300 group/btn shadow-lg shadow-cyan-500/50"
        >
          <!-- Ícono link externo -->
          <svg class="w-5 h-5 transition-transform duration-300 group-hover/btn:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
          <span class="card-demo-label">{demoLabel}</span>
        </a>
      )}
    </div>

    <!-- Slot: si quieres agregar contenido extra desde afuera -->
    <slot />
  </div>
</article>

<style>
  /* La card empieza invisible y baja animada cuando entra al viewport */
  .card {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s ease, transform 0.6s ease,
                border-color 0.5s, box-shadow 0.5s;
  }
  .card.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

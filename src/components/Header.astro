---
// Header.astro
// Navbar fijo. El texto se traduce solo via data-i18n (ver
// I18nEngine.astro) — este componente ya no necesita su propio
// script de idioma.
---

<header class="bg-ink-950/90 backdrop-blur-md border-b border-ink-700 py-4 px-6 md:px-10 flex items-center fixed top-0 w-full justify-between z-50">

  <a href="#home" class="font-display text-xl text-paper-50 font-semibold tracking-tight">
    Emilio<span class="text-accent-400">.</span>R
  </a>

  <!-- Nav escritorio -->
  <nav class="hidden md:block">
    <ul class="flex items-center gap-1 font-mono text-sm text-paper-300
               [&>li>a]:px-4 [&>li>a]:py-2 [&>li>a]:rounded-md [&>li>a]:transition-colors
               [&>li>a:hover]:text-accent-400">
      <li><a href="#home" data-i18n="nav.home">Home</a></li>
      <li><a href="#about" data-i18n="nav.about">About</a></li>
      <li><a href="#work" data-i18n="nav.work">Work</a></li>
      <!-- <li><a href="#art" data-i18n="nav.art">Art</a></li> -->
      <li><a href="#contact" data-i18n="nav.contact">Contact</a></li>
      <li class="ml-2">
        <select id="lang-select-desktop"
          class="lang-select bg-ink-800 border border-ink-600 text-paper-100 font-mono text-xs px-3 py-2 rounded-md
                 cursor-pointer hover:border-accent-500 transition-colors
                 focus:outline-none focus:ring-1 focus:ring-accent-500">
          <option value="es">ES</option>
          <option value="en">EN</option>
        </select>
      </li>
    </ul>
  </nav>

  <!-- Botón menú móvil -->
  <button id="menu-btn"
    class="md:hidden text-paper-100 p-2 hover:text-accent-400 transition-colors"
    aria-label="Abrir menú">
    <svg id="icon-hamburger" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
    <svg id="icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <!-- Nav móvil -->
  <nav id="mobile-menu"
    class="hidden absolute top-full left-0 w-full bg-ink-950/98 backdrop-blur-sm border-b border-ink-700">
    <ul class="flex flex-col font-mono text-base text-paper-300 py-4">
      <li><a href="#home"    class="nav-link-mobile block px-6 py-3 hover:text-accent-400 transition-colors" data-i18n="nav.home">Home</a></li>
      <li><a href="#about"   class="nav-link-mobile block px-6 py-3 hover:text-accent-400 transition-colors" data-i18n="nav.about">About</a></li>
      <li><a href="#work"    class="nav-link-mobile block px-6 py-3 hover:text-accent-400 transition-colors" data-i18n="nav.work">Work</a></li>
      <!-- <li><a href="#art"     class="nav-link-mobile block px-6 py-3 hover:text-accent-400 transition-colors" data-i18n="nav.art">Art</a></li> -->
      <li><a href="#contact" class="nav-link-mobile block px-6 py-3 hover:text-accent-400 transition-colors" data-i18n="nav.contact">Contact</a></li>
      <li class="px-6 py-3">
        <select id="lang-select-mobile"
          class="lang-select w-full bg-ink-800 border border-ink-600 text-paper-100 font-mono px-4 py-2 rounded-md
                 cursor-pointer focus:outline-none">
          <option value="es">ES</option>
          <option value="en">EN</option>
        </select>
      </li>
    </ul>
  </nav>
</header>

<script>
  const menuBtn       = document.getElementById('menu-btn');
  const mobileMenu    = document.getElementById('mobile-menu');
  const iconHamburger = document.getElementById('icon-hamburger');
  const iconClose     = document.getElementById('icon-close');

  // Guarda temprana: si falta alguno de los elementos, TS ya sabe
  // que de aquí en adelante ninguno es null (narrowing).
  if (menuBtn && mobileMenu && iconHamburger && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden', isOpen);
      iconHamburger.classList.toggle('hidden', !isOpen);
      iconClose.classList.toggle('hidden', isOpen);
    });

    document.querySelectorAll('.nav-link-mobile').forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconHamburger.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }

  // Scroll suave para links ancla
  document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
    anchor.addEventListener('click', (e) => {
      const href = anchor.getAttribute('href');
      if (!href) return; // sin href no hay a qué hacer scroll
      e.preventDefault();
      const target = document.querySelector(href);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>

<style>
  #mobile-menu { max-height: calc(100vh - 60px); overflow-y: auto; }
</style>
---
// Hero.astro — sección principal.
import translations from '../data/translations.json';
const tr = translations.es; // fallback de render inicial; el cliente re-traduce al cargar
---

<section id="home" class="min-h-screen flex items-center justify-center bg-ink-950 pt-24 pb-16 px-6 md:px-10 relative overflow-hidden">

  <!-- Textura de fondo sutil, tipo trama de papel -->
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
       style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>

  <div class="max-w-6xl w-full grid grid-cols-1 lg:grid-cols-[1.2fr_0.8fr] gap-16 items-center relative">

    <!-- Texto -->
    <div class="space-y-6 order-2 lg:order-1">
      <span class="section-label text-sm font-mono block reveal-up" style="animation-delay: 0.05s">home</span>

      <h2 class="text-2xl md:text-3xl font-medium text-paper-300 flex items-center gap-2 font-sans reveal-up" style="animation-delay: 0.15s">
        <span data-i18n="hero.greeting">{tr.hero.greeting}</span> <span class="wave">✎</span>
      </h2>

      <h1 id="hero-role" data-i18n="hero.role" class="text-6xl md:text-7xl font-display font-semibold text-paper-50 leading-[1.05] reveal-up" style="animation-delay: 0.25s">
        {tr.hero.role}
      </h1>

      <p id="hero-description" data-i18n="hero.description" class="text-lg md:text-xl text-paper-300 max-w-lg font-sans reveal-up" style="animation-delay: 0.35s">
        {tr.hero.description}
      </p>

      <!-- Redes sociales -->
      <div class="flex gap-3 pt-4 reveal-up" style="animation-delay: 0.45s">
        <a href={tr.hero.github} data-i18n-attr="href:hero.github" target="_blank" rel="noopener noreferrer"
          class="p-3 border border-ink-600 rounded-lg hover:border-accent-500 hover:text-accent-400 transition-all duration-300 group hover:-translate-y-1" aria-label="GitHub">
          <svg class="w-5 h-5 text-paper-300 group-hover:text-accent-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a href={tr.hero.linkedin} data-i18n-attr="href:hero.linkedin" target="_blank" rel="noopener noreferrer"
          class="p-3 border border-ink-600 rounded-lg hover:border-accent-500 hover:text-accent-400 transition-all duration-300 group hover:-translate-y-1" aria-label="LinkedIn">
          <svg class="w-5 h-5 text-paper-300 group-hover:text-accent-400" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a href="#contact" class="p-3 rounded-lg bg-accent-500 hover:bg-accent-600 text-ink-950 font-mono text-sm font-medium flex items-center gap-2 px-5 transition-colors hover:-translate-y-1">
          <span data-i18n="contact.title">Contáctame</span> →
        </a>
      </div>
    </div>

    <!-- Foto con marco tipo boceto -->
    <div class="order-1 lg:order-2 flex justify-center reveal-scale" style="animation-delay: 0.1s">
      <div class="sketch-frame relative">

        <!-- Globo de diálogo pidiendo el doble clic -->
        <div id="hero-bubble" class="speech-bubble" data-i18n="hero.doubleClickHint">{tr.hero.doubleClickHint ?? '¡Dame doble clic!'}</div>

        <div id="hero-picture-wrapper" class="w-64 h-64 md:w-80 md:h-80 rounded-2xl overflow-hidden border border-ink-600 bg-ink-800 relative select-none">
          <img id="hero-picture" src={tr.hero.picture} alt="Emilio R." class="w-full h-full object-cover" draggable="false" />
        </div>
      </div>
    </div>
  </div>

  <!-- Flecha scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-5 h-5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>

<style>
  .wave {
    display: inline-block;
    animation: wave 2.5s infinite;
    transform-origin: 70% 70%;
    color: var(--color-accent-400);
  }
  @keyframes wave {
    0%,60%,100% { transform: rotate(0deg);  }
    10%,30%     { transform: rotate(14deg); }
    20%         { transform: rotate(-8deg); }
    40%         { transform: rotate(-4deg); }
    50%         { transform: rotate(10deg); }
  }

  /* --- Animaciones de entrada --- */
  .reveal-up {
    opacity: 0;
    animation: reveal-up 0.7s cubic-bezier(.22,1,.36,1) forwards;
  }
  @keyframes reveal-up {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .reveal-scale {
    opacity: 0;
    animation: reveal-scale 0.8s cubic-bezier(.22,1,.36,1) forwards;
  }
  @keyframes reveal-scale {
    from { opacity: 0; transform: scale(0.9); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* --- Globo de diálogo --- */
  .speech-bubble {
    position: absolute;
    top: -0.75rem;
    right: -0.5rem;
    z-index: 10;
    background: var(--color-paper-50, #f5f0e8);
    color: var(--color-ink-950, #14120f);
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.5rem 0.85rem;
    border-radius: 1rem 1rem 1rem 0.2rem;
    box-shadow: 0 6px 16px rgba(0,0,0,0.25);
    white-space: nowrap;
    cursor: pointer;
    animation: bubble-in 0.6s cubic-bezier(.22,1,.36,1) 1.1s backwards,
               bubble-bob 2.4s ease-in-out 1.7s infinite;
    transform-origin: bottom right;
  }
  .speech-bubble::after {
    content: '';
    position: absolute;
    bottom: -0.4rem;
    right: 1.1rem;
    width: 0.9rem;
    height: 0.9rem;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 0 100%);
    transform: rotate(0deg);
  }
  @keyframes bubble-in {
    from { opacity: 0; transform: scale(0.4) translateY(6px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
  @keyframes bubble-bob {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50%      { transform: translateY(-4px) rotate(-2deg); }
  }
  .speech-bubble.bubble-hidden {
    animation: bubble-out 0.35s ease forwards;
    pointer-events: none;
  }
  @keyframes bubble-out {
    to { opacity: 0; transform: scale(0.5) translateY(-6px); }
  }

  /* --- Efecto de romper la imagen (tipo cartoon, animado con GSAP) --- */
  .shatter-container {
    position: absolute;
    inset: 0;
    z-index: 5;
    pointer-events: none;
    overflow: visible;
  }
  .shatter-piece {
    position: absolute;
    background-repeat: no-repeat;
    will-change: transform, opacity;
    transform-origin: center center;
  }

  /* pequeño "shake" del marco al impactar, como en cartoons */
  @keyframes frame-shake {
    0%   { transform: translate(0, 0) rotate(0deg); }
    20%  { transform: translate(-4px, 2px) rotate(-1.5deg); }
    40%  { transform: translate(3px, -2px) rotate(1.5deg); }
    60%  { transform: translate(-2px, 1px) rotate(-1deg); }
    80%  { transform: translate(2px, 0) rotate(0.5deg); }
    100% { transform: translate(0, 0) rotate(0deg); }
  }
  .frame-shaking {
    animation: frame-shake 0.4s ease;
  }

  #hero-picture {
    transition: opacity 0.4s ease, transform 0.3s ease;
  }
  #hero-picture-wrapper:hover #hero-picture {
    transform: scale(1.04);
  }
</style>

<script>
  import gsap from 'gsap';

  function initHeroInteractions() {
    const frame = document.getElementById('hero-picture-wrapper') as HTMLElement | null;
    const img = document.getElementById('hero-picture') as HTMLImageElement | null;
    const bubble = document.getElementById('hero-bubble') as HTMLElement | null;
    if (!frame || !img) return;

    let isShattering = false;

    function shatterImage() {
      if (isShattering || !img || !frame) return;
      isShattering = true;

      if (bubble) bubble.classList.add('bubble-hidden');
      frame.classList.add('frame-shaking');

      // Pedazos grandes (no confeti) para que se note el quiebre "a la mitad".
      const cols = 3;
      const rows = 3;
      const rect = img.getBoundingClientRect(); // posición real en el VIEWPORT
      const pieceW = rect.width / cols;
      const pieceH = rect.height / rows;

      // Ajuste fino de alineación: si los pedazos no calzan exacto sobre la
      // foto real, mueve estos valores (en px) hasta que encajen perfecto.
      const OFFSET_X = 8;  // positivo = mueve a la derecha, negativo = a la izquierda
      const OFFSET_Y = 0;  // positivo = mueve hacia abajo, negativo = hacia arriba

      // Clave del fix: el contenedor de pedazos se agrega al <body>, con
      // position:fixed, NO dentro del wrapper con overflow-hidden — así
      // nada los recorta cuando vuelan fuera del marco.
      const shatterContainer = document.createElement('div');
      shatterContainer.className = 'shatter-container';
      shatterContainer.style.position = 'fixed';
      shatterContainer.style.left = (rect.left + OFFSET_X) + 'px';
      shatterContainer.style.top = (rect.top + OFFSET_Y) + 'px';
      shatterContainer.style.width = rect.width + 'px';
      shatterContainer.style.height = rect.height + 'px';
      shatterContainer.style.zIndex = '9999';

      const pieces: HTMLElement[] = [];

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const piece = document.createElement('div');
          piece.className = 'shatter-piece';
          piece.style.width = pieceW + 'px';
          piece.style.height = pieceH + 'px';
          piece.style.left = (c * pieceW) + 'px';
          piece.style.top = (r * pieceH) + 'px';
          piece.style.backgroundImage = `url(${img.src})`;
          piece.style.backgroundSize = `${rect.width}px ${rect.height}px`;
          piece.style.backgroundPosition = `-${c * pieceW}px -${r * pieceH}px`;
          shatterContainer.appendChild(piece);
          pieces.push(piece);
        }
      }

      img.style.opacity = '0';
      document.body.appendChild(shatterContainer);

      // --- Animación GSAP: pop -> se abre "a la mitad" -> cae fuera de pantalla -> fade ---
      const tl = gsap.timeline({
        onComplete: () => {
          shatterContainer.remove();
          frame.classList.remove('frame-shaking');
          if (img) img.style.opacity = '1';
          isShattering = false;
          if (bubble) {
            bubble.classList.remove('bubble-hidden');
            bubble.style.animation = 'none';
            void bubble.offsetWidth;
            bubble.style.animation = '';
          }
        },
      });

      pieces.forEach((piece, i) => {
        const col = i % cols;
        // mitad izquierda vuela a la izquierda, mitad derecha vuela a la derecha
        const dir = col < cols / 2 ? -1 : col > cols / 2 ? 1 : (Math.random() < 0.5 ? -1 : 1);

        const burst = 70 + Math.random() * 60;       // impulso lateral al separarse
        const fall = 550 + Math.random() * 350;      // caída larga, fuera de la pantalla
        const rot = dir * (140 + Math.random() * 260);
        const delay = Math.random() * 0.1;

        const midX = dir * burst;
        const midY = -30 - Math.random() * 40; // sube un poco antes de caer, como en cartoons

        const endX = midX + dir * (50 + Math.random() * 70);
        const endY = midY + fall;

        // 1) pop exagerado (squash & stretch) al romperse
        tl.fromTo(
          piece,
          { scale: 1, x: 0, y: 0, rotation: 0, opacity: 1 },
          { scale: 1.25, duration: 0.12, ease: 'back.out(4)' },
          delay
        )
          // 2) se abre hacia su lado (izquierda o derecha) — la "mitad" del quiebre
          .to(
            piece,
            { x: midX, y: midY, rotation: rot * 0.4, scale: 1, duration: 0.28, ease: 'power2.out' },
            delay + 0.05
          )
          // 3) cae con gravedad, saliendo de la pantalla
          .to(
            piece,
            { x: endX, y: endY, rotation: rot, duration: 0.65, ease: 'power1.in' },
            delay + 0.32
          )
          // 4) se desvanece justo antes de terminar
          .to(
            piece,
            { opacity: 0, duration: 0.25, ease: 'power1.in' },
            delay + 0.75
          );
      });
    }

    frame.addEventListener('dblclick', shatterImage);

    // soporte táctil: doble tap en móvil
    let lastTap = 0;
    frame.addEventListener('touchend', () => {
      const now = Date.now();
      if (now - lastTap < 300) shatterImage();
      lastTap = now;
    });
  }

  document.addEventListener('DOMContentLoaded', initHeroInteractions);
  // por si navegas con View Transitions de Astro
  document.addEventListener('astro:page-load', initHeroInteractions);
</script>
---
// Art.astro
// Galería de arte. Los archivos se detectan automáticamente desde
// src/assets/art/ — solo hay que soltar imágenes ahí, sin tocar
// este componente ni ningún JSON.
import translations from '../data/translations.json';
const tr = translations.es;

const artFiles = import.meta.glob('/src/assets/art/*.{png,jpg,jpeg,webp,PNG,JPG,JPEG,WEBP}', {
  eager: true,
  import: 'default',
});

const pieces = Object.entries(artFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    src: mod.src ?? mod,
    name: path.split('/').pop()?.replace(/\.\w+$/, '').replace(/^\d+[-_]?/, '').replace(/[-_]/g, ' '),
  }));
---

<section id="art" class="min-h-screen flex items-center justify-center bg-ink-950 py-20 px-6 md:px-10">
  <div class="max-w-6xl w-full">

    <div class="text-center mb-4">
      <span class="section-label text-sm font-mono block mb-3">art</span>
      <div class="relative inline-block mb-4">
        <h2 data-i18n="art.title" class="text-5xl md:text-6xl font-display font-semibold text-paper-50">
          {tr.art.title}
        </h2>
        <span class="absolute -bottom-2 left-0 w-full h-1 bg-gradient-to-r from-coral-500 to-accent-400 rounded-full"></span>
      </div>
    </div>

    <p data-i18n="art.subtitle" class="text-center text-paper-300 text-lg max-w-xl mx-auto mb-14">
      {tr.art.subtitle}
    </p>

    {pieces.length > 0 ? (
      <div class="columns-2 md:columns-3 gap-4 [&>*]:mb-4">
        {pieces.map((piece) => (
          <button
            type="button"
            class="art-piece block w-full break-inside-avoid ink-card overflow-hidden group cursor-zoom-in"
            data-src={piece.src}
            data-name={piece.name}
          >
            <img
              src={piece.src}
              alt={piece.name}
              loading="lazy"
              class="w-full h-auto object-cover group-hover:opacity-80 transition-opacity duration-300"
            />
          </button>
        ))}
      </div>
    ) : (
      <div class="ink-card p-12 text-center max-w-md mx-auto">
        <svg class="w-10 h-10 text-accent-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14M4 4h16v16H4V4z"/>
        </svg>
        <p data-i18n="art.empty" class="text-paper-300">{tr.art.empty}</p>
      </div>
    )}
  </div>

  <!-- Lightbox -->
  <div id="art-lightbox" class="hidden fixed inset-0 bg-ink-950/95 z-[100] items-center justify-center p-6 cursor-zoom-out">
    <img id="art-lightbox-img" src="" alt="" class="max-w-full max-h-[85vh] rounded-lg shadow-2xl" />
    <p id="art-lightbox-name" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-paper-300 font-mono text-sm capitalize"></p>
  </div>
</section>

<script>
  const lightbox    = document.getElementById('art-lightbox');
  const lightboxImg = document.getElementById('art-lightbox-img');
  const lightboxName = document.getElementById('art-lightbox-name');

  document.querySelectorAll('.art-piece').forEach((el) => {
    el.addEventListener('click', () => {
      lightboxImg.src = el.dataset.src;
      lightboxImg.alt = el.dataset.name || '';
      lightboxName.textContent = el.dataset.name || '';
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });
  });

  lightbox?.addEventListener('click', () => {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  });
</script>

---
// About.astro
// Versión minimalista: un párrafo, una lista de tecnologías en
// texto plano (sin la grilla de 13 iconos con tarjetas, que
// resultaba abrumadora) y una foto, en vez de varias cajas
// apiladas con bordes.
import translations from '../data/translations.json';
const tr = translations.es;

const techStack = [
  'HTML', 'CSS', 'JavaScript', 'TypeScript',
  'React', 'Express', 'Laravel', 'PHP',
  'C#', 'MySQL', 'SQL Server', 'Git',
];
---

<section id="about" class="min-h-screen flex items-center justify-center bg-ink-950 py-24 px-6 md:px-10">
  <div class="max-w-5xl w-full">

    <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_0.7fr] gap-14 items-start">

      <!-- Texto -->
      <div class="space-y-7 order-2 lg:order-1">
        <div>
          <span class="section-label text-sm font-mono block mb-3">about</span>
          <h2 data-i18n="about.title" class="text-4xl md:text-5xl font-display font-semibold text-paper-50">
            {tr.about.title}
          </h2>
        </div>

        <p data-i18n="about.description" class="text-paper-300 text-lg leading-relaxed max-w-xl">
          {tr.about.description}
        </p>

        <!-- Tech stack: texto plano en dos columnas, sin iconos ni tarjetas -->
        <div>
          <h3 data-i18n="about.techStack" class="text-sm font-mono text-accent-400 mb-3">
            {tr.about.techStack}
          </h3>
          <ul class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-2 max-w-lg">
            {techStack.map((tech) => (
              <li class="flex items-center gap-2 text-paper-300 text-sm">
                <span class="text-coral-500">▸</span>
                {tech}
              </li>
            ))}
          </ul>
        </div>

        <!-- Educación: texto plano, sin tarjeta -->
        <div>
          <h3 data-i18n="about.education" class="text-sm font-mono text-accent-400 mb-2">
            {tr.about.education}
          </h3>
          <p class="text-paper-50 font-medium">Ingeniería de Software</p>
          <p class="text-paper-300 text-sm">Universidad Autónoma de Occidente · 2021 – 2025</p>
        </div>

        <!-- Aprendizaje continuo: una línea de cierre, sin caja destacada -->
        <p class="text-paper-300/70 text-sm max-w-xl">
          <span data-i18n="about.continuousLearningDescription">{tr.about.continuousLearningDescription}</span>
        </p>
      </div>

      <!-- Foto -->
      <!-- <div class="order-1 lg:order-2 flex justify-center lg:justify-end">
        <div class="sketch-frame">
          <div class="w-56 h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden border border-ink-600 bg-ink-800">
            <img src={tr.hero.picture} alt="Emilio R." class="w-full h-full object-cover" />
          </div>
        </div>
      </div> -->
    </div>
  </div>
</section>
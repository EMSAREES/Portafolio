---
// Layout.astro
// Este es el "esqueleto" HTML de toda la app.
// Igual que en React cuando tienes un componente que envuelve todo con <html><body>
import '../styles/globales.css';

interface Props {
  title?: string;
}

const { title = 'Portafolio — Emilio R.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-900 text-white">
    <!-- <slot /> es igual que {children} en React -->
    <slot />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>

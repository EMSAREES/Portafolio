---
// Layout.astro
// Esqueleto HTML de toda la app. Incluye fuentes, meta tags para
// compartir en redes (Open Graph) y el motor de i18n una sola vez.
import '../styles/globales.css';
import I18nEngine from '../components/I18nEngine.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Emilio R. — Desarrollador & Ilustrador',
  description = 'Portafolio de Emilio Reyes: desarrollo web y desktop, además de arte e ilustración.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d0d12" />
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/img/imagen.webp" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <title>{title}</title>
  </head>
  <body class="bg-ink-950 text-paper-100">
    <slot />
    <I18nEngine />
  </body>
</html>

<style>
  html, body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
